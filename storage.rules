rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mateixa llista de comptes que a firestore.rules (vegeu-ne el comentari).
    // Les imatges es mostren a la web amb URLs amb token, que no passen per
    // aquestes regles; aqui nomes es protegeix la lectura directa i l'escriptura.
    function permes() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [__ALLOWED_EMAILS__];
    }
    match /recipe-images/{fileName} {
      allow read: if permes();
      allow create, update: if permes()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if permes();
    }
  }
}
